<?xml version="1.0"?>
<sdf version="1.6">
  <model name="pluto_simple">
    <static>false</static>

    <link name="body">
      <pose>0 0 0.28 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.32 0.20 0.08</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <material>
          <ambient>1.0 0.25 0.75 1</ambient>
          <diffuse>1.0 0.35 0.85 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
        <geometry>
          <box>
            <size>0.32 0.20 0.08</size>
          </box>
        </geometry>
      </visual>
    </link>

    <!-- TOP_LEFT -->
    <link name="top_left_leg">
      <pose>0.11 0.13 0.18 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.035 0.035 0.20</size></box></geometry>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.035 0.035 0.20</size></box></geometry>
      </collision>
    </link>

    <joint name="top_left_hip" type="revolute">
      <parent>body</parent>
      <child>top_left_leg</child>
      <pose>0.11 0.10 0.25 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
        </limit>
      </axis>
    </joint>

    <!-- TOP_RIGHT -->
    <link name="top_right_leg">
      <pose>0.11 -0.13 0.18 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.035 0.035 0.20</size></box></geometry>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.035 0.035 0.20</size></box></geometry>
      </collision>
    </link>

    <joint name="top_right_hip" type="revolute">
      <parent>body</parent>
      <child>top_right_leg</child>
      <pose>0.11 -0.10 0.25 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
        </limit>
      </axis>
    </joint>

    <!-- BOTTOM_LEFT -->
    <link name="bottom_left_leg">
      <pose>-0.11 0.13 0.18 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.035 0.035 0.20</size></box></geometry>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.035 0.035 0.20</size></box></geometry>
      </collision>
    </link>

    <joint name="bottom_left_hip" type="revolute">
      <parent>body</parent>
      <child>bottom_left_leg</child>
      <pose>-0.11 0.10 0.25 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
        </limit>
      </axis>
    </joint>

    <!-- BOTTOM_RIGHT -->
    <link name="bottom_right_leg">
      <pose>-0.11 -0.13 0.18 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.035 0.035 0.20</size></box></geometry>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.035 0.035 0.20</size></box></geometry>
      </collision>
    </link>

    <joint name="bottom_right_hip" type="revolute">
      <parent>body</parent>
      <child>bottom_right_leg</child>
      <pose>-0.11 -0.10 0.25 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
        </limit>
      </axis>
    </joint>

  <plugin
    filename="libpluto_gait_plugin.dylib"
    name="PlutoGaitPlugin"/>  </model>
</sdf>